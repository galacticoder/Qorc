+
+/** Schedule a single prompt retry for a descriptor whose upload connection
+ * failed before an HSDir returned an HTTP response. Return the jittered delay
+ * in seconds when scheduled, or 0 when a retry is already pending, the
+ * normal upload is due sooner, or the prompt retry budget is exhausted. */
+STATIC int
+service_desc_schedule_retry(hs_service_descriptor_t *desc, time_t now)
+{
+  unsigned int backoff, delay;
+  time_t retry_at;
+
+  tor_assert(desc);
+
+  if (desc->upload_retry_pending ||
+      desc->upload_retry_attempts >=
+        HS_SERVICE_UPLOAD_RETRY_ATTEMPTS_MAX) {
+    return 0;
+  }
+
+  backoff = desc->upload_retry_delay;
+  if (backoff < HS_SERVICE_UPLOAD_RETRY_TIME_MIN) {
+    backoff = HS_SERVICE_UPLOAD_RETRY_TIME_MIN;
+  }
+  /* Full jitter keeps the current and next descriptors, and separate
+   * services sharing a failed network path, from retrying in lockstep. The
+   * largest retry is 150--299 seconds. */
+  delay = crypto_rand_int_range(backoff, backoff * 2);
+  retry_at = now + delay;
+
+  if (desc->next_upload_time > 0 && desc->next_upload_time <= retry_at) {
+    return 0;
+  }
+  desc->next_upload_time = retry_at;
+  desc->upload_retry_pending = 1;
+  desc->upload_retry_attempts++;
+  desc->upload_retry_delay = MIN(backoff * 2,
+                                 HS_SERVICE_UPLOAD_RETRY_TIME_MAX);
+  return (int) delay;
+}
+
+/** Find the descriptor named by ident and arrange a bounded retry. */
+void
+hs_service_desc_upload_failed(const hs_ident_dir_conn_t *ident)
+{
+  hs_service_t *service;
+  hs_service_descriptor_t *desc = NULL;
+  time_t now = time(NULL);
+
+  if (BUG(!ident) || !hs_service_map) {
+    return;
+  }
+
+  service = find_service(hs_service_map, &ident->identity_pk);
+  if (!service) {
+    return;
+  }
+  if (service->desc_current &&
+      ed25519_pubkey_eq(&service->desc_current->blinded_kp.pubkey,
+                        &ident->blinded_pk)) {
+    desc = service->desc_current;
+  } else if (service->desc_next &&
+             ed25519_pubkey_eq(&service->desc_next->blinded_kp.pubkey,
+                               &ident->blinded_pk)) {
+    desc = service->desc_next;
+  }
+
+  if (desc) {
+    int delay = service_desc_schedule_retry(desc, now);
+    if (delay <= 0) {
+      return;
+    }
+    log_notice(LD_REND, "Service %s descriptor upload circuit failed; "
+                        "retrying the descriptor in %u seconds.",
+               safe_str_client(service->onion_address), (unsigned int) delay);
+  }
+}
+
+/** Emit an unambiguous publication marker for the application supervisor.
+ * The ordinary HTTP success log does not identify whether it accepted the
+ * current or next-period descriptor. */
+void
+hs_service_desc_upload_succeeded(const hs_ident_dir_conn_t *ident)
+{
+  hs_service_t *service;
+  const char *descriptor_kind = NULL;
+
+  if (BUG(!ident) || !hs_service_map) {
+    return;
+  }
+  service = find_service(hs_service_map, &ident->identity_pk);
+  if (!service) {
+    return;
+  }
+  if (service->desc_current &&
+      ed25519_pubkey_eq(&service->desc_current->blinded_kp.pubkey,
+                        &ident->blinded_pk)) {
+    descriptor_kind = "current";
+  } else if (service->desc_next &&
+             ed25519_pubkey_eq(&service->desc_next->blinded_kp.pubkey,
+                               &ident->blinded_pk)) {
+    descriptor_kind = "next";
+  }
+
+  if (descriptor_kind) {
+    log_notice(LD_REND, "QORC_HS_DESC_READY %s", descriptor_kind);
   }
 }
 
