+static void
+test_upload_retry_schedule(void *arg)
+{
+  hs_service_descriptor_t *desc = NULL;
+  const time_t now = 1700000000;
+
+  (void) arg;
+  desc = service_descriptor_new();
+  tt_assert(desc);
+
+  desc->next_upload_time = now + 3600;
+  int first_delay = service_desc_schedule_retry(desc, now);
+  tt_int_op(first_delay, OP_GE, HS_SERVICE_UPLOAD_RETRY_TIME_MIN);
+  tt_int_op(first_delay, OP_LT, HS_SERVICE_UPLOAD_RETRY_TIME_MIN * 2);
+  tt_i64_op(desc->next_upload_time, OP_EQ, now + first_delay);
+  tt_uint_op(desc->upload_retry_delay, OP_EQ,
+             HS_SERVICE_UPLOAD_RETRY_TIME_MIN * 2);
+  tt_uint_op(desc->upload_retry_attempts, OP_EQ, 1);
+  tt_int_op(desc->upload_retry_pending, OP_EQ, 1);
+
+  /* Parallel failures from the same upload batch remain single-flight. */
+  tt_int_op(service_desc_schedule_retry(desc, now + 1), OP_EQ, 0);
+  tt_i64_op(desc->next_upload_time, OP_EQ, now + first_delay);
+
+  /* A later failed batch backs off, but still retries in seconds rather than
+   * waiting for the normal hourly publication interval. */
+  desc->upload_retry_pending = 0;
+  desc->next_upload_time = now + 3600;
+  int second_delay = service_desc_schedule_retry(desc, now + 10);
+  tt_int_op(second_delay, OP_GE, HS_SERVICE_UPLOAD_RETRY_TIME_MIN * 2);
+  tt_int_op(second_delay, OP_LT, HS_SERVICE_UPLOAD_RETRY_TIME_MIN * 4);
+  tt_i64_op(desc->next_upload_time, OP_EQ, now + 10 + second_delay);
+  tt_uint_op(desc->upload_retry_attempts, OP_EQ, 2);
+
+  /* Backoff is capped and jitter never defers a retry by five minutes. */
+  desc->upload_retry_pending = 0;
+  desc->upload_retry_delay = HS_SERVICE_UPLOAD_RETRY_TIME_MAX;
+  desc->next_upload_time = now + 3600;
+  int capped_delay = service_desc_schedule_retry(desc, now + 20);
+  tt_int_op(capped_delay, OP_GE, HS_SERVICE_UPLOAD_RETRY_TIME_MAX);
+  tt_int_op(capped_delay, OP_LT, HS_SERVICE_UPLOAD_RETRY_TIME_MAX * 2);
+  tt_uint_op(desc->upload_retry_attempts, OP_EQ, 3);
+
+  /* A mixed batch with at least one permanently unreachable HSDir must not
+   * fan out forever. Once the prompt budget is exhausted, retain the normal
+   * publication deadline. */
+  desc->upload_retry_pending = 0;
+  desc->upload_retry_attempts = HS_SERVICE_UPLOAD_RETRY_ATTEMPTS_MAX;
+  desc->next_upload_time = now + 3600;
+  tt_int_op(service_desc_schedule_retry(desc, now + 30), OP_EQ, 0);
+  tt_int_op(desc->upload_retry_pending, OP_EQ, 0);
+  tt_uint_op(desc->upload_retry_attempts, OP_EQ,
+             HS_SERVICE_UPLOAD_RETRY_ATTEMPTS_MAX);
+  tt_i64_op(desc->next_upload_time, OP_EQ, now + 3600);
+
+  /* Do not misclassify an upload that is already due sooner as a retry. */
+  desc->upload_retry_pending = 0;
+  desc->upload_retry_attempts = 2;
+  desc->next_upload_time = now + 1;
+  tt_int_op(service_desc_schedule_retry(desc, now), OP_EQ, 0);
+  tt_int_op(desc->upload_retry_pending, OP_EQ, 0);
+  tt_uint_op(desc->upload_retry_attempts, OP_EQ, 2);
+  tt_i64_op(desc->next_upload_time, OP_EQ, now + 1);
+
+  /* Descriptor changes create a new prompt retry budget. */
+  desc->upload_retry_delay = HS_SERVICE_UPLOAD_RETRY_TIME_MAX;
+  desc->upload_retry_attempts = HS_SERVICE_UPLOAD_RETRY_ATTEMPTS_MAX;
+  desc->upload_retry_pending = 1;
+  service_desc_schedule_upload(desc, now + 40, 1);
+  tt_uint_op(desc->upload_retry_delay, OP_EQ, 0);
+  tt_uint_op(desc->upload_retry_attempts, OP_EQ, 0);
+  tt_int_op(desc->upload_retry_pending, OP_EQ, 0);
+  tt_i64_op(desc->next_upload_time, OP_EQ, now + 40);
+
+ done:
+  service_descriptor_free(desc);
+}
