FROM ubuntu:26.04@sha256:61b65dc6bddff5e68c552f22126fe77496395f956ff2e983e05d8a52efd63e55 AS builder

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/root/.cargo/bin:$PATH

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        clang \
        cmake \
        curl \
        desktop-file-utils \
        file \
        git \
        gstreamer1.0-libav \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-plugins-base \
        gstreamer1.0-plugins-good \
        gstreamer1.0-plugins-ugly \
        gstreamer1.0-pipewire \
        gstreamer1.0-tools \
        libayatana-appindicator3-dev \
        libgstreamer-plugins-base1.0-dev \
        libgstreamer1.0-dev \
        libgtk-3-dev \
        libpipewire-0.3-0 \
        libpulse-dev \
        librsvg2-dev \
        libspa-0.2-modules \
        libssl-dev \
        libv4l-dev \
        libwebkit2gtk-4.1-dev \
        libxdo-dev \
        nodejs \
        ninja-build \
        npm \
        patchelf \
        perl \
        pkg-config \
        protobuf-compiler \
        rpm \
        wget \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global pnpm@10.33.4 --no-audit --no-fund \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal --default-toolchain 1.95.0

WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY src-tauri/Cargo.toml src-tauri/Cargo.lock src-tauri/
COPY vendor/ vendor/
RUN cargo fetch --locked --manifest-path src-tauri/Cargo.toml

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gstreamer1.0-gl \
        libxcb-randr0-dev \
        qemu-user \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN node scripts/start-client.cjs --bundle-only \
    && deb_bundle="$(find src-tauri/target/release/bundle -type f -name '*arm64.deb' -print -quit)" \
    && rpm_bundle="$(find src-tauri/target/release/bundle -type f -name '*aarch64.rpm' -print -quit)" \
    && appimage_bundle="$(find src-tauri/target/release/bundle -type f -name '*aarch64.AppImage' -print -quit)" \
    && test -n "$deb_bundle" \
    && test -n "$rpm_bundle" \
    && test -n "$appimage_bundle" \
    && test "$(dpkg-deb --field "$deb_bundle" Architecture)" = arm64 \
    && test "$(rpm -qp --qf '%{ARCH}' "$rpm_bundle")" = aarch64 \
    && file "$appimage_bundle" | grep -q 'ARM aarch64'

FROM scratch
COPY --from=builder /workspace/src-tauri/target/release/bundle/ /bundle/
