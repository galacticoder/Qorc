FROM ubuntu:22.04@sha256:4f838adc7181d9039ac795a7d0aba05a9bd9ecd480d294483169c5def983b64d AS tor-builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    libevent-dev \
    liblzma-dev \
    libssl-dev \
    libzstd-dev \
    patch \
    pkg-config \
    python3 \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY docker/tor/patches/0001-retry-hsdesc-upload.patch /build/hsdesc-upload-retry.patch

RUN curl --fail --silent --show-error \
      --proto '=https' --tlsv1.2 --max-filesize 16777216 \
      --output tor.tar.gz \
      https://dist.torproject.org/tor-0.4.9.11.tar.gz \
    && echo "2e6c1720118c812acf0079fd47cf91b6bfaba5d766c321c4d3d2a28d6a11a8ed  tor.tar.gz" | sha256sum -c - \
    && echo "0e1f8eea86ba7ce2798c11cd4656b1e6a8d5b9d5eaaaa8349102c787040a1b51  hsdesc-upload-retry.patch" | sha256sum -c - \
    && tar --extract --gzip --file tor.tar.gz --no-same-owner --no-same-permissions \
    && cd tor-0.4.9.11 \
    && patch --batch --forward --fuzz=0 -p1 < ../hsdesc-upload-retry.patch \
    && ./configure \
      --prefix=/opt/qor-tor \
      --disable-asciidoc \
      --disable-html-manual \
      --disable-manpage \
      --disable-system-torrc \
      --enable-gcc-hardening \
      --enable-linker-hardening \
    && make -j"$(nproc)" src/app/tor src/test/test \
    && src/test/test hs_service/upload_retry_schedule \
    && install -D -m 0755 src/app/tor /opt/qor-tor/bin/tor

FROM ubuntu:22.04@sha256:4f838adc7181d9039ac795a7d0aba05a9bd9ecd480d294483169c5def983b64d

ENV DEBIAN_FRONTEND=noninteractive
ENV LB_TOR_BIN=/opt/qor-tor/bin/tor

LABEL org.qor-chat.tor.version="0.4.9.11" \
      org.qor-chat.tor.source-sha256="2e6c1720118c812acf0079fd47cf91b6bfaba5d766c321c4d3d2a28d6a11a8ed" \
      org.qor-chat.tor.patch-sha256="0e1f8eea86ba7ce2798c11cd4656b1e6a8d5b9d5eaaaa8349102c787040a1b51"

RUN apt-get update && apt-get install -y \
    curl \
    libssl-dev \
    ca-certificates \
    gnupg \
    iptables \
    iproute2 \
    tor \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y \
    nodejs \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=tor-builder /opt/qor-tor /opt/qor-tor

WORKDIR /app

COPY scripts/ ./scripts/
COPY server/ ./server/
COPY shared/ ./shared/

RUN node scripts/install-deps.cjs --quantum
RUN node scripts/install-deps.cjs --edge
RUN node scripts/install-deps.cjs --server

EXPOSE 8443 8080 8404

COPY server/package.json /app/package.json
RUN npm install tar
RUN npm install

CMD ["node", "scripts/start-loadbalancer.cjs"]
