FROM ubuntu:22.04@sha256:2edbbc5dc405e9612ba3584ce95480277e3eb374407b5505fe26f17df77c7dbc AS edge-runtime

COPY docker/edge-runtime/qor-edge-runtime-linux-x86_64-v1.tar.gz /tmp/qor-edge-runtime-linux-amd64-v1.tar.gz
COPY docker/edge-runtime/qor-edge-runtime-linux-arm64-v1.tar.gz /tmp/qor-edge-runtime-linux-arm64-v1.tar.gz

RUN architecture="$(dpkg --print-architecture)" \
    && case "$architecture" in \
      amd64) archive=/tmp/qor-edge-runtime-linux-amd64-v1.tar.gz; expected=c3a9cf4759fb29f17b9e0e4e4da5e6213dd5cd7a8602f9ed695cb12be89e4c33 ;; \
      arm64) archive=/tmp/qor-edge-runtime-linux-arm64-v1.tar.gz; expected=92be78df8acccba83c7c5afe5c21ed8cacb0996c665212a3f5373a4cdf46b1b2 ;; \
      *) echo "Unsupported edge-runtime architecture: $architecture" >&2; exit 1 ;; \
    esac \
    && echo "$expected  $archive" | sha256sum -c - \
    && tar --extract --gzip --file "$archive" \
      --directory /opt --no-same-owner --no-same-permissions \
    && test -x /opt/qor-edge/bin/haproxy \
    && test -x /opt/qor-edge/tor/tor

FROM ubuntu:22.04@sha256:2edbbc5dc405e9612ba3584ce95480277e3eb374407b5505fe26f17df77c7dbc

ENV DEBIAN_FRONTEND=noninteractive
ENV LD_LIBRARY_PATH=/opt/qor-edge/lib

LABEL org.qor-chat.tor.version="0.4.9.11" \
      org.qor-chat.tor.source-sha256="2e6c1720118c812acf0079fd47cf91b6bfaba5d766c321c4d3d2a28d6a11a8ed" \
      org.qor-chat.tor.patch-sha256="0e1f8eea86ba7ce2798c11cd4656b1e6a8d5b9d5eaaaa8349102c787040a1b51" \
      org.qor-chat.haproxy.version="3.2.21" \
      org.qor-chat.haproxy.source-sha256="0cb8818a26c5f888e0cb1c40f1b3acb9fb952527d1733f769ce688fedd680339" \
      org.qor-chat.edge-runtime.amd64.sha256="c3a9cf4759fb29f17b9e0e4e4da5e6213dd5cd7a8602f9ed695cb12be89e4c33" \
      org.qor-chat.edge-runtime.arm64.sha256="92be78df8acccba83c7c5afe5c21ed8cacb0996c665212a3f5373a4cdf46b1b2"

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    iptables \
    iproute2 \
    openssl \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y \
    nodejs \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=edge-runtime /opt/qor-edge /opt/qor-edge
COPY docker/edge-runtime/THIRD_PARTY_NOTICES.txt /opt/qor-edge/THIRD_PARTY_NOTICES.txt

WORKDIR /app

COPY scripts/ ./scripts/
COPY server/ ./server/
COPY shared/ ./shared/

EXPOSE 8443 8080 8404

COPY server/package.json /app/package.json
RUN npm install --omit=dev --no-audit --no-fund \
    && npm cache clean --force

CMD ["node", "scripts/start-loadbalancer.cjs"]
