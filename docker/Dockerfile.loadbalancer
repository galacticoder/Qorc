FROM ubuntu:22.04@sha256:2edbbc5dc405e9612ba3584ce95480277e3eb374407b5505fe26f17df77c7dbc AS edge-runtime

COPY docker/edge-runtime/qorc-edge-runtime-linux-x86_64-v1.tar.gz /tmp/qorc-edge-runtime-linux-amd64-v1.tar.gz
COPY docker/edge-runtime/qorc-edge-runtime-linux-arm64-v1.tar.gz /tmp/qorc-edge-runtime-linux-arm64-v1.tar.gz

RUN architecture="$(dpkg --print-architecture)" \
    && case "$architecture" in \
      amd64) archive=/tmp/qorc-edge-runtime-linux-amd64-v1.tar.gz; expected=41876029965386aa0623f4d34c8956aac664ac4f9e85e39ae3309fb0d0d3b095 ;; \
      arm64) archive=/tmp/qorc-edge-runtime-linux-arm64-v1.tar.gz; expected=f24331e5685b04ba73ecc79b61a3deead1453537e97ba6816e3ed543c1f21fb0 ;; \
      *) echo "Unsupported edge-runtime architecture: $architecture" >&2; exit 1 ;; \
    esac \
    && echo "$expected  $archive" | sha256sum -c - \
    && tar --extract --gzip --file "$archive" \
      --directory /opt --no-same-owner --no-same-permissions \
    && test -x /opt/qorc-edge/bin/haproxy \
    && test -x /opt/qorc-edge/tor/tor

FROM ubuntu:22.04@sha256:2edbbc5dc405e9612ba3584ce95480277e3eb374407b5505fe26f17df77c7dbc

ENV DEBIAN_FRONTEND=noninteractive
ENV LD_LIBRARY_PATH=/opt/qorc-edge/lib

LABEL org.qorc.tor.version="0.4.9.11" \
      org.qorc.tor.source-sha256="2e6c1720118c812acf0079fd47cf91b6bfaba5d766c321c4d3d2a28d6a11a8ed" \
      org.qorc.tor.patch-sha256="d7a6dcf124a9402f0c72ba41aa3dac5f3ca1c699814ac4ebda3411a7935e07f4" \
      org.qorc.haproxy.version="3.2.21" \
      org.qorc.haproxy.source-sha256="0cb8818a26c5f888e0cb1c40f1b3acb9fb952527d1733f769ce688fedd680339" \
      org.qorc.edge-runtime.amd64.sha256="41876029965386aa0623f4d34c8956aac664ac4f9e85e39ae3309fb0d0d3b095" \
      org.qorc.edge-runtime.arm64.sha256="f24331e5685b04ba73ecc79b61a3deead1453537e97ba6816e3ed543c1f21fb0"

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    gnupg \
    iptables \
    iproute2 \
    openssl \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list \
    && apt-get update && apt-get install -y \
    nodejs \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY --from=edge-runtime /opt/qorc-edge /opt/qorc-edge
COPY docker/edge-runtime/THIRD_PARTY_NOTICES.txt /opt/qorc-edge/THIRD_PARTY_NOTICES.txt

WORKDIR /app

COPY scripts/ ./scripts/
COPY server/ ./server/
COPY shared/ ./shared/

EXPOSE 8443 8080

COPY server/package.json /app/package.json
RUN npm install --omit=dev --no-audit --no-fund \
    && npm cache clean --force

CMD ["node", "scripts/start-loadbalancer.cjs"]
